# PostgreSQL Configuration
POSTGRES_DB=afriyan1
POSTGRES_USER=afriyan
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5433

# Spring Boot Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/test
SPRING_DATASOURCE_USERNAME=toto
SPRING_DATASOURCE_PASSWORD=12345
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Swagger Configuration
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui-custom.html

# File Upload Configuration
SPRING_WEB_RESOURCES_STATIC_LOCATIONS=classpath:/static/,file:uploads/
FILE_UPLOAD_DIR=uploads/
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# SMS Configuration (LMT Group)
LMT_ACCOUNT_SID=your_account_sid
LMT_AUTH_TOKEN=your_auth_token
LMT_SENDER=AfriYAN CMR
LMT_URL=https://sms.lmtgroup.com/api/v1/pushes

# Email Configuration
SPRING_MAIL_HOST=smtp.camoo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@domain.com
SPRING_MAIL_PASSWORD=your_email_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Images Configuration
UNFPA_PHOTO=classpath:/images/unfpa.png
YOUNG_LOGO=classpath:/images/logo192.png

# Weather API Configuration
WEATHER_WEBSITE=https://home.openweathermap.org/
WEATHER_KEY=your_weather_api_key
WEATHER_URL=https://api.openweathermap.org/data/2.5/forecast?q={ville},CM&appid=your_weather_api_key&units=metric&lang=fr

# Application Ports
APP_PORT=8087
SERVER_PORT=8087

# JMX Configuration
SPRING_JMX_ENABLED=false
